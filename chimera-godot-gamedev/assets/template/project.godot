; Engine configuration file.
; Godot 4.7 project. Edit via the editor or carefully by hand (keep section names).

config_version=5

[application]

config/name="Chimera Epoch 奇美拉纪元"
config/description="基因进化 × 肉鸽 × 半自动战棋。选择始祖种族，掠夺异族基因，融合出属于你的物种。"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Data="*res://src/autoload/data_registry.gd"
Rng="*res://src/autoload/rng_service.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.07, 0.065, 0.08, 1)
