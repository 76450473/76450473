# Godot 4
.godot/
/android/
/build/
*.tmp
export_credentials.cfg
# local tool output
/screenshots/*.png
!/screenshots/.gitkeep
!/screenshots/.gdignore
/reports/
# packs / skill archives dropped into the project root are never committed
/*.zip
/提示词.txt
/美术资产清单与提示词.txt
# OS junk and per-user Claude Code permissions
.DS_Store
Thumbs.db
desktop.ini
.claude/settings.local.json
# raw user uploads (processed results live in art/ and ARE committed)
/art_inbox/*
!/art_inbox/README.txt
!/art_inbox/.gdignore
